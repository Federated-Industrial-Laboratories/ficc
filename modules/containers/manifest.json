{
  "format_version": 1,
  "id": "org.ficc.containers",
  "version": "1.0.0",
  "category": "containers",
  "contract_version": 1,
  "host_api": 1,
  "display_name": "Containers",
  "publisher": "Federated Industrial Laboratories",
  "description": "Read Docker, Podman and Kubernetes workloads, logs and confirmed state changes.",
  "runtime": {
    "kind": "python",
    "language": "python",
    "protocol": 2,
    "platform": "linux",
    "architecture": "any",
    "entry": "main.py"
  },
  "capabilities": [
    "workspace:read",
    "container:read",
    "container:logs",
    "container:power"
  ],
  "optional_capabilities": [
    "container:logs",
    "container:power"
  ],
  "dependencies": [],
  "actions": [
    {
      "id": "load",
      "label": "Read workloads",
      "parameters": {
        "provider": {
          "type": "string",
          "choices": [
            "all",
            "docker",
            "podman",
            "kubernetes"
          ]
        },
        "kind": {
          "type": "string",
          "choices": [
            "all",
            "container",
            "pod",
            "deployment",
            "statefulset"
          ]
        },
        "offset": {
          "type": "integer",
          "min": 0,
          "max": 4096
        }
      },
      "capabilities": [
        "container:read"
      ]
    },
    {
      "id": "preview-start",
      "label": "Preview start",
      "parameters": {
        "resource_ids": {
          "type": "string-list",
          "required": true,
          "max_items": 64,
          "max_length": 128
        }
      },
      "capabilities": [
        "container:read",
        "container:power"
      ]
    },
    {
      "id": "preview-stop",
      "label": "Preview stop",
      "parameters": {
        "resource_ids": {
          "type": "string-list",
          "required": true,
          "max_items": 64,
          "max_length": 128
        }
      },
      "capabilities": [
        "container:read",
        "container:power"
      ]
    },
    {
      "id": "preview-scale",
      "label": "Preview scale",
      "parameters": {
        "resource_ids": {
          "type": "string-list",
          "required": true,
          "max_items": 64,
          "max_length": 128
        },
        "replicas": {
          "type": "integer",
          "required": true,
          "min": 0,
          "max": 64
        }
      },
      "capabilities": [
        "container:read",
        "container:power"
      ]
    },
    {
      "id": "logs",
      "label": "Read logs",
      "parameters": {
        "resource_ids": {
          "type": "string-list",
          "required": true,
          "max_items": 64,
          "max_length": 128
        },
        "container": {
          "type": "string",
          "max_length": 63
        }
      },
      "capabilities": [
        "container:read",
        "container:logs"
      ]
    }
  ],
  "ui": {
    "type": "column",
    "children": [
      {
        "type": "text",
        "text": "Select systems with registered container profiles. Select pods for Kubernetes logs, or Deployment and StatefulSet workloads to scale. State changes require host confirmation."
      },
      {
        "type": "toolbar",
        "children": [
          {
            "type": "select",
            "name": "provider",
            "label": "Provider",
            "value": "all",
            "options": [
              {
                "id": "all",
                "label": "All"
              },
              {
                "id": "docker",
                "label": "Docker"
              },
              {
                "id": "podman",
                "label": "Podman"
              },
              {
                "id": "kubernetes",
                "label": "Kubernetes"
              }
            ]
          },
          {
            "type": "select",
            "name": "kind",
            "label": "Kind",
            "value": "all",
            "options": [
              {
                "id": "all",
                "label": "All"
              },
              {
                "id": "container",
                "label": "Container"
              },
              {
                "id": "pod",
                "label": "Pod"
              },
              {
                "id": "deployment",
                "label": "Deployment"
              },
              {
                "id": "statefulset",
                "label": "Statefulset"
              }
            ]
          },
          {
            "type": "field",
            "name": "offset",
            "label": "Inventory offset",
            "input_type": "number",
            "value": 0
          },
          {
            "type": "button",
            "label": "Read workloads",
            "action": "load",
            "parameters": {
              "provider": {
                "field": "provider"
              },
              "kind": {
                "field": "kind"
              },
              "offset": {
                "field": "offset"
              }
            }
          }
        ]
      },
      {
        "type": "text",
        "text": "",
        "bind": {
          "text": {
            "action": "load",
            "path": [
              "results",
              0,
              "data",
              "notice"
            ]
          }
        }
      },
      {
        "type": "table",
        "id": "workloads",
        "selection": "multiple",
        "page_size": 32,
        "columns": [
          {
            "id": "name",
            "label": "Name"
          },
          {
            "id": "kind",
            "label": "Kind"
          },
          {
            "id": "system",
            "label": "System"
          },
          {
            "id": "provider",
            "label": "Provider"
          },
          {
            "id": "namespace",
            "label": "Namespace"
          },
          {
            "id": "state",
            "label": "State"
          },
          {
            "id": "replicas",
            "label": "Replicas"
          },
          {
            "id": "error",
            "label": "Error"
          }
        ],
        "rows": [],
        "bind": {
          "rows": {
            "action": "load",
            "path": [
              "results",
              0,
              "data",
              "rows"
            ]
          }
        }
      },
      {
        "type": "toolbar",
        "children": [
          {
            "type": "button",
            "label": "Preview start",
            "action": "preview-start",
            "parameters": {
              "resource_ids": {
                "selection": "workloads"
              }
            }
          },
          {
            "type": "button",
            "label": "Preview stop",
            "action": "preview-stop",
            "parameters": {
              "resource_ids": {
                "selection": "workloads"
              }
            }
          }
        ]
      },
      {
        "type": "toolbar",
        "children": [
          {
            "type": "field",
            "name": "replicas",
            "label": "Desired replicas (0 to 64)",
            "input_type": "number",
            "value": 1
          },
          {
            "type": "button",
            "label": "Preview scale",
            "action": "preview-scale",
            "parameters": {
              "resource_ids": {
                "selection": "workloads"
              },
              "replicas": {
                "field": "replicas"
              }
            }
          }
        ]
      },
      {
        "type": "toolbar",
        "children": [
          {
            "type": "field",
            "name": "container",
            "label": "Pod container name (optional)",
            "input_type": "text",
            "value": ""
          },
          {
            "type": "button",
            "label": "Read logs",
            "action": "logs",
            "parameters": {
              "resource_ids": {
                "selection": "workloads"
              },
              "container": {
                "field": "container"
              }
            }
          }
        ]
      },
      {
        "type": "log",
        "label": "Workload logs",
        "lines": [],
        "bind": {
          "lines": {
            "action": "logs",
            "path": [
              "results",
              0,
              "data",
              "lines"
            ]
          }
        }
      }
    ]
  },
  "files": {}
}
