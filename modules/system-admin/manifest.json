{
  "format_version": 1,
  "id": "org.ficc.system-admin",
  "version": "1.0.1",
  "category": "system-administration",
  "contract_version": 1,
  "host_api": 1,
  "display_name": "System administration",
  "publisher": "Federated Industrial Laboratories",
  "description": "Read systemd status, services and logs. Request host-confirmed service and power changes.",
  "runtime": {
    "kind": "python",
    "language": "python",
    "protocol": 2,
    "platform": "linux",
    "architecture": "any",
    "entry": "main.py"
  },
  "capabilities": [
    "workspace:read",
    "admin:read",
    "admin:logs",
    "admin:services",
    "admin:power"
  ],
  "optional_capabilities": [
    "admin:logs",
    "admin:services",
    "admin:power"
  ],
  "dependencies": [],
  "actions": [
    {
      "id": "load",
      "label": "Read systems and services",
      "parameters": {
        "kind": {
          "type": "string",
          "choices": [
            "all",
            "system",
            "service"
          ]
        },
        "offset": {
          "type": "integer",
          "min": 0,
          "max": 4096
        }
      },
      "capabilities": [
        "admin:read"
      ]
    },
    {
      "id": "preview-start",
      "label": "Preview start",
      "parameters": {
        "resource_ids": {
          "type": "string-list",
          "required": true,
          "max_items": 64,
          "max_length": 128
        }
      },
      "capabilities": [
        "admin:read",
        "admin:services"
      ]
    },
    {
      "id": "preview-stop",
      "label": "Preview stop",
      "parameters": {
        "resource_ids": {
          "type": "string-list",
          "required": true,
          "max_items": 64,
          "max_length": 128
        }
      },
      "capabilities": [
        "admin:read",
        "admin:services"
      ]
    },
    {
      "id": "preview-restart",
      "label": "Preview restart",
      "parameters": {
        "resource_ids": {
          "type": "string-list",
          "required": true,
          "max_items": 64,
          "max_length": 128
        }
      },
      "capabilities": [
        "admin:read",
        "admin:services"
      ]
    },
    {
      "id": "preview-reboot",
      "label": "Preview reboot",
      "parameters": {
        "resource_ids": {
          "type": "string-list",
          "required": true,
          "max_items": 64,
          "max_length": 128
        }
      },
      "capabilities": [
        "admin:read",
        "admin:power"
      ]
    },
    {
      "id": "preview-poweroff",
      "label": "Preview poweroff",
      "parameters": {
        "resource_ids": {
          "type": "string-list",
          "required": true,
          "max_items": 64,
          "max_length": 128
        }
      },
      "capabilities": [
        "admin:read",
        "admin:power"
      ]
    },
    {
      "id": "logs",
      "label": "Read service logs",
      "parameters": {
        "resource_ids": {
          "type": "string-list",
          "required": true,
          "max_items": 64,
          "max_length": 128
        }
      },
      "capabilities": [
        "admin:read",
        "admin:logs"
      ]
    }
  ],
  "ui": {
    "type": "column",
    "children": [
      {
        "type": "text",
        "text": "Select systems with a registered user or system service manager. Check Power permission before shutdown. Authentication required means system policy needs setup outside FICC. Service and power changes require host confirmation. A power acknowledgement means queued; inspect the system before resolving its receipt."
      },
      {
        "type": "toolbar",
        "children": [
          {
            "type": "select",
            "name": "kind",
            "label": "Resource kind",
            "value": "all",
            "options": [
              {
                "id": "all",
                "label": "All"
              },
              {
                "id": "system",
                "label": "System"
              },
              {
                "id": "service",
                "label": "Service"
              }
            ]
          },
          {
            "type": "field",
            "name": "offset",
            "label": "Inventory offset",
            "input_type": "number",
            "value": 0
          },
          {
            "type": "button",
            "label": "Read systems and services",
            "action": "load",
            "parameters": {
              "kind": {
                "field": "kind"
              },
              "offset": {
                "field": "offset"
              }
            }
          }
        ]
      },
      {
        "type": "text",
        "text": "",
        "bind": {
          "text": {
            "action": "load",
            "path": [
              "results",
              0,
              "data",
              "notice"
            ]
          }
        }
      },
      {
        "type": "table",
        "id": "resources",
        "selection": "multiple",
        "page_size": 32,
        "columns": [
          {
            "id": "name",
            "label": "Name"
          },
          {
            "id": "kind",
            "label": "Kind"
          },
          {
            "id": "system",
            "label": "System"
          },
          {
            "id": "state",
            "label": "State"
          },
          {
            "id": "detail",
            "label": "Detail"
          },
          {
            "id": "power",
            "label": "Power permission"
          },
          {
            "id": "uptime",
            "label": "Uptime (seconds)"
          },
          {
            "id": "memory",
            "label": "Available memory (bytes)"
          },
          {
            "id": "error",
            "label": "Error"
          }
        ],
        "rows": [],
        "bind": {
          "rows": {
            "action": "load",
            "path": [
              "results",
              0,
              "data",
              "rows"
            ]
          }
        }
      },
      {
        "type": "toolbar",
        "children": [
          {
            "type": "button",
            "label": "Preview start",
            "action": "preview-start",
            "parameters": {
              "resource_ids": {
                "selection": "resources"
              }
            }
          },
          {
            "type": "button",
            "label": "Preview stop",
            "action": "preview-stop",
            "parameters": {
              "resource_ids": {
                "selection": "resources"
              }
            }
          },
          {
            "type": "button",
            "label": "Preview restart",
            "action": "preview-restart",
            "parameters": {
              "resource_ids": {
                "selection": "resources"
              }
            }
          }
        ]
      },
      {
        "type": "toolbar",
        "children": [
          {
            "type": "button",
            "label": "Preview reboot",
            "action": "preview-reboot",
            "parameters": {
              "resource_ids": {
                "selection": "resources"
              }
            }
          },
          {
            "type": "button",
            "label": "Preview poweroff",
            "action": "preview-poweroff",
            "parameters": {
              "resource_ids": {
                "selection": "resources"
              }
            }
          }
        ]
      },
      {
        "type": "button",
        "label": "Read service logs",
        "action": "logs",
        "parameters": {
          "resource_ids": {
            "selection": "resources"
          }
        }
      },
      {
        "type": "log",
        "label": "Service logs",
        "lines": [],
        "bind": {
          "lines": {
            "action": "logs",
            "path": [
              "results",
              0,
              "data",
              "lines"
            ]
          }
        }
      }
    ]
  },
  "files": {}
}
