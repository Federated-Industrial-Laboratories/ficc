[Unit]
Description=Federated Industrial Cluster Commander
After=network.target

[Service]
Type=exec
ExecStart=%h/.local/share/ficc/venv/bin/ficc serve
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
RuntimeDirectory=ficc
RuntimeDirectoryMode=0700
Environment=TMPDIR=%t/ficc

[Install]
WantedBy=default.target
